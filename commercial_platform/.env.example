# ==============================================================================
# NexoraAI V14.2 Cloud Commercial Service — Environment Variable Template
# ==============================================================================
# Security Policy: NEVER commit real credentials, private keys, or API tokens
# to version control. Set these variables in your deployment platform's secrets
# manager (e.g., Render Environment Variables, Fly.io Secrets, Railway Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Networking & Bind Configuration
# ------------------------------------------------------------------------------
# Bind host: Use 0.0.0.0 for Docker containers and cloud platforms; 127.0.0.1 for local dev behind reverse proxy.
HOST=0.0.0.0

# Bind port: Render, Fly.io, and Cloud Run dynamically pass PORT (typically 8080 or 10000).
PORT=8080

# Verbose HTTP access logging: 1 for detailed request lines, 0 for production silent mode.
NEXORA_VERBOSE_HTTP=0

# Path to persistent SQLite commercial database (use volume mount path in production containers).
NEXORA_DB_PATH=/data/nexora_commercial_v14_1.sqlite3

# Global API rate limit per IP per minute (protects against brute-force and DoS).
NEXORA_RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (Generate using `python3 -c "import secrets; print(secrets.token_hex(32))"`)
# ------------------------------------------------------------------------------
# Secret for HMAC-SHA256 signature and integrity verification of user session tokens.
NEXORA_SESSION_HMAC_SECRET=replace_with_64_char_hex_session_secret

# Private server signing key for issuing cryptographic license tokens and offline lease digests.
# STRICT RULE: NEVER embed this key in desktop clients or distribution bundles.
NEXORA_LICENSE_PRIVATE_KEY=replace_with_64_char_hex_license_private_signing_key

# Secret for generating short-lived, single-use, HMAC-signed download authorization tokens.
NEXORA_DOWNLOAD_HMAC_SECRET=replace_with_64_char_hex_download_token_secret

# Secret for verifying HMAC-SHA256 signatures on inbound merchant webhooks (Stripe / Lemon Squeezy).
NEXORA_PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signing_secret_whsec_xxxx

# ------------------------------------------------------------------------------
# 3. Commercial Payment Integration Kill-Switch
# ------------------------------------------------------------------------------
# STRICT RULE: Keep 'false' until legitimate merchant onboarding is completed by an authorized adult.
# When 'false', all /api/v1/payments/checkout endpoints return HTTP 503.
NEXORA_ENABLE_LIVE_PAYMENTS=false

# ------------------------------------------------------------------------------
# 4. Secure Object Storage (Cloudflare R2 / AWS S3) for Large Desktop Installers
# ------------------------------------------------------------------------------
# Storage backend: 'local' serves directly from disk; 's3_presigned' redirects clients via short-lived AWS SigV4 GET URLs.
# Cloudflare R2 is strongly recommended: 10 GB free storage and $0.00 egress bandwidth cost.
NEXORA_STORAGE_BACKEND=local

# S3 endpoint URL:
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: https://s3.<region>.amazonaws.com
NEXORA_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# S3 bucket name containing private desktop installers (e.g., NexoraAI_V14_2_Native_Desktop_Installer.tar.gz).
NEXORA_S3_BUCKET=nexora-commercial-releases

# S3 region ('auto' for Cloudflare R2, 'us-east-1' or similar for AWS S3).
NEXORA_S3_REGION=auto

# S3 Access Key ID (with read permissions on release bucket).
NEXORA_S3_ACCESS_KEY_ID=your_storage_access_key_id

# S3 Secret Access Key (never exposed to clients; server signs download URLs using pure-Python SigV4).
NEXORA_S3_SECRET_ACCESS_KEY=your_storage_secret_access_key

# ------------------------------------------------------------------------------
# 5. Initial Administrator Bootstrap (Optional)
# ------------------------------------------------------------------------------
# Set these to auto-create the initial admin account upon first startup.
# Omit or leave empty if manual creation via CLI script is preferred.
NEXORA_ADMIN_INITIAL_EMAIL=admin@nexora.local
NEXORA_ADMIN_INITIAL_PASSWORD=replace_with_strong_initial_admin_password
NEXORA_ADMIN_INITIAL_NAME=Nexora Administrator
NEXORA_DISABLE_ADMIN_BOOTSTRAP=0
